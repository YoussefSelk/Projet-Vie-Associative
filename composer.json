{
  "name": "eilco/vie-etudiante",
  "description": "EILCO Student Life - Clubs & Events Platform",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.0",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "test-unit": "phpunit --configuration phpunit.xml --testsuite Unit",
    "test-feature": "phpunit --configuration phpunit.xml --testsuite Feature",
    "security:audit": "composer audit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist"
  }
}
