# ===========================================
# Application Environment Configuration
# ===========================================
# Copy this file to .env and update values
#
# SUPPORTED ENVIRONMENTS:
# - Apache (with mod_rewrite)
# - Apache on XAMPP/WAMP/MAMP/Laragon
# - Nginx (use nginx.conf.example)
# - IIS (uses web.config automatically)
# - LiteSpeed
#
# SUPPORTED BROWSERS:
# - Chrome 60+, Firefox 55+, Safari 11+, Edge 79+
# - Safari iOS 11+, Chrome Android 60+
# - Internet Explorer 11 (degradation gracieuse)

# Application Settings
APP_ENV=development         # Options: development, staging, production
APP_DEBUG=false             # Set to true only in development
APP_TIMEZONE=Europe/Paris   # IANA timezone (used by reminders and date logic)
APP_URL=https://yourdomain.com
APP_NAME="Your Application Name"

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_secure_password
DB_CHARSET=utf8mb4

# ===========================================
# Email Configuration (SMTP)
# ===========================================
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl         # ssl for 465, tls for 587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_secure_email_password
MAIL_FROM=noreply@domain.com
MAIL_FROM_NAME="Your App Name"
MAIL_TIMEOUT=15
MAIL_VERIFY_PEER=true
MAIL_VERIFY_PEER_NAME=true
MAIL_ALLOW_SELF_SIGNED=false

# Optional fallback SMTP (recommended for resilience)
SMTP_FALLBACK_ENABLED=false
SMTP_FALLBACK_ON_ANY_ERROR=false
SMTP_FALLBACK_HOST=smtp-relay.example.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_ENCRYPTION=tls
SMTP_FALLBACK_USER=relay_user
SMTP_FALLBACK_PASS=relay_password
SMTP_FALLBACK_FROM_EMAIL=noreply@domain.com
SMTP_FALLBACK_FROM_NAME="Your App Name"
SMTP_FALLBACK_TIMEOUT=15
SMTP_FALLBACK_VERIFY_PEER=true
SMTP_FALLBACK_VERIFY_PEER_NAME=true
SMTP_FALLBACK_ALLOW_SELF_SIGNED=false

# Optional aliases (legacy compatibility)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=465
# SMTP_ENCRYPTION=ssl
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_secure_email_password
# SMTP_FROM_EMAIL=noreply@domain.com
# SMTP_FROM_NAME="Your App Name"
# SMTP_TIMEOUT=15
# SMTP_VERIFY_PEER=true
# SMTP_VERIFY_PEER_NAME=true
# SMTP_ALLOW_SELF_SIGNED=false

# ===========================================
# Security Settings
# ===========================================
SESSION_LIFETIME=3600       # Session lifetime in seconds (1 hour)
CSRF_TOKEN_LIFETIME=7200    # CSRF token lifetime in seconds (2 hours)
COOKIE_SECURE=true          # Set to false for local development without HTTPS
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict      # Options: Strict, Lax, None

# ===========================================
# Server Environment Detection
# ===========================================
# The application auto-detects server type (Apache, Nginx, IIS)
# These settings are used for environment-specific configurations
SERVER_TYPE=auto            # Options: auto, apache, nginx, iis
